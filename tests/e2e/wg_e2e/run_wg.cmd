@echo off
rem ===========================================================================
rem  wg_e2e (SuVtitle): the REAL app\web\index.html (the player) in wv2probe -- a real WebView2, MUTED, never focused
rem  (WS_EX_NOACTIVATE), on the SECOND screen (-1880,40 = inside the monitor at -1920,0) -- fed by a fake bridge (make_wg.js),
rem  media generated by ..\make_media.js (skipped when already there).
rem  Usage: run_wg.cmd [G1 G2 G2M G3 G4 G5 G6 G7 G8 G8M G9]   (default: all 11, in that order; any subset, any order), then
rem  check_wg.js judges them. Before the runs: check_hosts_wg.js (the media host the page is fed IS the product's, RV4-12) and its
rem  --selftest (the check fails on the textbook FNV basis). G2M and G8M are the SENTINELS of G2's and G8's layout checks: the same
rem  runs with the pre-fix CSS put back by the feed; check_wg.js requires their layout checks to FAIL there.
rem  The judges themselves are proven by `node mutants_wg.js` (opt-in, a few minutes): one guard of the page undone per mutant, the run
rem  replayed on that copy, check_wg.js required to FAIL on the check named -- a run that cannot be made to fail is not testing anything.
rem  Rendering: on the GPU, as the product (its three switches, app\main.cpp); set WE_CPU=1 to keep Chromium OFF the GPU
rem  (software compositing + video decode) when the user needs it.
rem  PORTED (T-WG, 2026-10-23) from AudioPB 641f1aa's scratchpad\filemode_2026-10-10\we_e2e\run_wg.cmd, in the pattern of
rem  ..\we_e2e\run_we.cmd: node instead of python, the page https://suvtitle.local/index.html, the product's three browser switches,
rem  outputs in runs\ and profiles udf_<run>\ (both git-ignored; a profile is recreated at every run so no setting of a previous run
rem  leaks in). Sizes as the python kit: G5 420x320, G9 1280x800, the others 1000x720.
rem ===========================================================================
setlocal
cd /d "%~dp0"
set "WV=%~dp0..\wv2probe\wv2probe.exe"
for %%I in ("%~dp0..\..\..\app\web") do set "WEB=%%~fI"
if not exist "%WV%" echo run_wg: wv2probe.exe missing -- run ..\wv2probe\build.cmd first& exit /b 1
node ..\make_media.js || exit /b 1
node make_wg.js || exit /b 1
node check_hosts_wg.js || exit /b 1
node check_hosts_wg.js --selftest || exit /b 1
set "SW=--autoplay-policy=no-user-gesture-required --disable-direct-composition-video-overlays --enable-blink-features=AudioVideoTracks"
set "CPUSW="
if "%WE_CPU%"=="1" set "CPUSW=--disable-gpu --disable-gpu-compositing --disable-accelerated-video-decode"
set "LIST=%*"
if "%LIST%"=="" set "LIST=G1 G2 G2M G3 G4 G5 G6 G7 G8 G8M G9"
for %%K in (%LIST%) do call :one %%K
node check_wg.js %LIST%
exit /b %ERRORLEVEL%

:one
set "K=%~1"
set "SIZE=1000x720"
if /i "%K%"=="G5" set "SIZE=420x320"
if /i "%K%"=="G9" set "SIZE=1280x800"
set "BARGS=%CPUSW% %SW%"
if exist "runs\%K%.jsonl" del "runs\%K%.jsonl"
if exist "udf_%K%" rmdir /s /q "udf_%K%" 2>nul
"%WV%" --url https://suvtitle.local/index.html --serve "suvtitle.local=%WEB%" ^
  --product-settings --no-smartscreen --feed "runs\feed_%K%.jsonl" --out "runs\%K%.jsonl" --udf "udf_%K%" ^
  --size %SIZE% --timeout 90000 --quiet --browser-args "%BARGS%"
echo [%K%] wv2probe exit %ERRORLEVEL%
exit /b 0
