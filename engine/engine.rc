// SuVtitle - engine/engine.rc   (SuVtitleEngine.exe's icon and version resource; new 2026-10-23)
// ASCII only: the build has no /utf-8, and rc.exe reads the file in the ANSI code page.
// AudioPB's helper compiled the tray's own .rc ("same icon: a helper in Task Manager is still AudioPB"); the
// engine does the same with SuVtitle's: the ICON below is app\suvtitle.ico -- S-HOST's PLACEHOLDER until the
// user gives SuVtitle its icon -- so replacing that one file re-brands both executables.
#include "EngineVersion.h"
#include <winres.h>

IDI_ENGINEICON ICON "../app/suvtitle.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    SUVTITLE_ENGINE_VERSION_MAJOR,SUVTITLE_ENGINE_VERSION_MINOR,SUVTITLE_ENGINE_VERSION_PATCH,0
 PRODUCTVERSION SUVTITLE_ENGINE_VERSION_MAJOR,SUVTITLE_ENGINE_VERSION_MINOR,SUVTITLE_ENGINE_VERSION_PATCH,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS__WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "NEXTALE"
            VALUE "FileDescription",  "SuVtitle Engine"
            VALUE "FileVersion",      SUVTITLE_ENGINE_VERSION_STR
            VALUE "InternalName",     "SuVtitleEngine"
            VALUE "OriginalFilename", "SuVtitleEngine.exe"
            VALUE "ProductName",      "SuVtitle"
            VALUE "ProductVersion",   SUVTITLE_ENGINE_VERSION_STR
            VALUE "LegalCopyright",   "(c) 2026 NEXTALE"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
