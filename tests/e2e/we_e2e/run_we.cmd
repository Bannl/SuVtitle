@echo off
rem ===========================================================================
rem  we_e2e (SuVtitle): the REAL app\web\index.html (the player) in wv2probe -- a real WebView2, MUTED, never focused
rem  (WS_EX_NOACTIVATE), on the SECOND screen (-1880,40 = inside the monitor at -1920,0) -- fed by a fake bridge (make_we.js),
rem  media generated by ..\make_media.js (skipped when already there).
rem  Usage: run_we.cmd [V C X P K A N W F T H D R Z]   (default: all 14, in that order; any subset, any order), then
rem  check_we.js judges them. Before the runs: check_hosts.js (the media host names the page is fed ARE the product's, RV4-12)
rem  and its --selftest (the check fails on the textbook FNV basis).
rem  The judges themselves are proven by `node mutants_we.js` (opt-in, ~90 s): one guard of the page undone per mutant, the run replayed on
rem  that copy, check_we.js required to FAIL on the check named -- a run that cannot be made to fail is not testing anything.
rem  Rendering: on the GPU, as the product (its three switches, app\main.cpp); set WE_CPU=1 to keep Chromium OFF the GPU
rem  (software compositing + video decode) when the user needs it. Z is the one run WITHOUT the switches: app\main.cpp's
rem  retry-without environment (no autoplay switch -> the refused play() becomes a big Play button).
rem  PORTED (S-WEB, 2026-10-23) from AudioPB 641f1aa's scratchpad\filemode_2026-10-10\we_e2e\run_we.cmd: node instead
rem  of python, the page https://suvtitle.local/index.html, outputs in runs\ and profiles udf_<run>\ (both git-ignored; a
rem  profile is recreated at every run so no setting of a previous run leaks in). T-E2E, 2026-10-23 (RV4-11): all 14 runs
rem  (L and LM dropped: no Live mode in SuVtitle), sizes as the python kit (N 420x320, W and D 1280x800, F 1600x900).
rem ===========================================================================
setlocal
cd /d "%~dp0"
set "WV=%~dp0..\wv2probe\wv2probe.exe"
for %%I in ("%~dp0..\..\..\app\web") do set "WEB=%%~fI"
if not exist "%WV%" echo run_we: wv2probe.exe missing -- run ..\wv2probe\build.cmd first& exit /b 1
node ..\make_media.js || exit /b 1
node make_we.js || exit /b 1
node check_hosts.js || exit /b 1
node check_hosts.js --selftest || exit /b 1
set "SW=--autoplay-policy=no-user-gesture-required --disable-direct-composition-video-overlays --enable-blink-features=AudioVideoTracks"
set "CPUSW="
if "%WE_CPU%"=="1" set "CPUSW=--disable-gpu --disable-gpu-compositing --disable-accelerated-video-decode"
set "LIST=%*"
if "%LIST%"=="" set "LIST=V C X P K A N W F T H D R Z"
for %%K in (%LIST%) do call :one %%K
node check_we.js %LIST%
exit /b %ERRORLEVEL%

:one
set "K=%~1"
set "SIZE=1000x720"
if /i "%K%"=="N" set "SIZE=420x320"
if /i "%K%"=="W" set "SIZE=1280x800"
if /i "%K%"=="D" set "SIZE=1280x800"
if /i "%K%"=="F" set "SIZE=1600x900"
set "BARGS=%CPUSW% %SW%"
if /i "%K%"=="Z" set "BARGS=%CPUSW%"
set "EXTRA="
if defined BARGS set EXTRA=--browser-args "%BARGS%"
if exist "runs\%K%.jsonl" del "runs\%K%.jsonl"
if exist "udf_%K%" rmdir /s /q "udf_%K%" 2>nul
"%WV%" --url https://suvtitle.local/index.html --serve "suvtitle.local=%WEB%" ^
  --product-settings --no-smartscreen --feed "runs\feed_%K%.jsonl" --out "runs\%K%.jsonl" --udf "udf_%K%" ^
  --size %SIZE% --timeout 90000 --quiet %EXTRA%
echo [%K%] wv2probe exit %ERRORLEVEL%
exit /b 0
